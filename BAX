local Players      = game:GetService("Players")
local RunService   = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting     = game:GetService("Lighting")
local CoreGui      = game:GetService("CoreGui")
local lp           = Players.LocalPlayer

local screenGui   = nil
local panel       = nil
local scrollFrame = nil

for _ = 1, 100 do
    screenGui   = CoreGui:FindFirstChild("ESPGui")
    panel       = screenGui and screenGui:FindFirstChild("ScrollSC", true)
    scrollFrame = panel
    if not scrollFrame then
        panel       = screenGui and screenGui:FindFirstChild("Panel")
        scrollFrame = panel and panel:FindFirstChild("ScrollSC", true)
    end
    if scrollFrame then break end
    task.wait(0.1)
end
if not scrollFrame then warn("[Tab_Bax] ScrollSC not found") return end
task.wait(0.3)

-- ============================================================
--  HELPERS
-- ============================================================
local function makeCorner(p, r)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r or 8); c.Parent = p
end
local function makeStroke(p, col, th, trans)
    local s = Instance.new("UIStroke")
    s.Color = col or Color3.fromRGB(60,60,90); s.Thickness = th or 1
    s.Transparency = trans or 0; s.Parent = p
end
local function makeHeader(txt, order)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1,-4,0,24); f.BackgroundTransparency = 1
    f.LayoutOrder = order; f.Parent = scrollFrame
    local accent = Instance.new("Frame")
    accent.Size = UDim2.new(0,3,0,14); accent.Position = UDim2.new(0,2,0.5,-7)
    accent.BackgroundColor3 = Color3.fromRGB(100,120,255); accent.BorderSizePixel = 0
    accent.Parent = f; makeCorner(accent,2)
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1,-14,1,0); l.Position = UDim2.new(0,12,0,0)
    l.BackgroundTransparency = 1; l.Text = txt
    l.TextColor3 = Color3.fromRGB(160,170,220); l.Font = Enum.Font.FredokaOne
    l.TextSize = 12; l.TextXAlignment = Enum.TextXAlignment.Left; l.Parent = f
end
local function makeGrid(order)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1,-4,0,0); f.AutomaticSize = Enum.AutomaticSize.Y
    f.BackgroundTransparency = 1; f.BorderSizePixel = 0
    f.LayoutOrder = order; f.Parent = scrollFrame
    local g = Instance.new("UIGridLayout")
    g.CellSize = UDim2.new(0.5,-4,0,52); g.CellPadding = UDim2.new(0,4,0,4)
    g.SortOrder = Enum.SortOrder.LayoutOrder; g.Parent = f
    return f
end
local function makeToggle(parent, label, color, onToggle)
    local row = Instance.new("Frame")
    row.BackgroundColor3 = Color3.fromRGB(18,20,34); row.BorderSizePixel = 0
    row.Size = UDim2.new(1,0,1,0); row.Parent = parent
    makeCorner(row,8); makeStroke(row, Color3.fromRGB(45,45,70),1,0)
    local pill = Instance.new("Frame")
    pill.Size = UDim2.new(0,4,0,18); pill.Position = UDim2.new(0,6,0.5,-9)
    pill.BackgroundColor3 = color; pill.BorderSizePixel = 0; pill.Parent = row; makeCorner(pill,3)
    local swBg = Instance.new("TextButton")
    swBg.Size = UDim2.new(0,36,0,18); swBg.Position = UDim2.new(1,-42,0.5,-9)
    swBg.BackgroundColor3 = Color3.fromRGB(40,40,65); swBg.BorderSizePixel = 0
    swBg.Text = ""; swBg.AutoButtonColor = false; swBg.Parent = row
    makeCorner(swBg,9); makeStroke(swBg, Color3.fromRGB(60,60,90),1,0)
    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0,12,0,12); knob.Position = UDim2.new(0,3,0.5,-6)
    knob.BackgroundColor3 = Color3.fromRGB(140,140,170); knob.BorderSizePixel = 0
    knob.Parent = swBg; makeCorner(knob,6)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1,-58,1,0); lbl.Position = UDim2.new(0,16,0,0)
    lbl.BackgroundTransparency = 1; lbl.Text = label
    lbl.TextColor3 = Color3.fromRGB(210,215,235); lbl.Font = Enum.Font.FredokaOne
    lbl.TextSize = 12; lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextWrapped = true; lbl.Parent = row
    local enabled = false
    local ti = TweenInfo.new(0.15,Enum.EasingStyle.Quad,Enum.EasingDirection.Out)
    local function refresh()
        if enabled then
            TweenService:Create(swBg,ti,{BackgroundColor3=Color3.fromRGB(60,160,255)}):Play()
            TweenService:Create(knob,ti,{Position=UDim2.new(0,21,0.5,-6),BackgroundColor3=Color3.fromRGB(255,255,255)}):Play()
            TweenService:Create(row,ti,{BackgroundColor3=Color3.fromRGB(16,26,48)}):Play()
        else
            TweenService:Create(swBg,ti,{BackgroundColor3=Color3.fromRGB(40,40,65)}):Play()
            TweenService:Create(knob,ti,{Position=UDim2.new(0,3,0.5,-6),BackgroundColor3=Color3.fromRGB(140,140,170)}):Play()
            TweenService:Create(row,ti,{BackgroundColor3=Color3.fromRGB(18,20,34)}):Play()
        end
    end
    swBg.MouseButton1Click:Connect(function()
        enabled = not enabled; refresh(); onToggle(enabled)
    end)
    refresh()
end

-- ============================================================
--  AD BLOCKER
-- ============================================================
local adBlockConn = nil
local AD_KEYWORDS = {"ScreenGui","AdGui","Advertisement","Popup","Ad_","_Ad"}
local hiddenGuis  = {}

local function blockAds()
    local function hideIfAd(gui)
        for _, kw in ipairs(AD_KEYWORDS) do
            if gui.Name:find(kw) and gui ~= screenGui then
                if gui.Enabled then
                    gui.Enabled = false
                    table.insert(hiddenGuis, gui)
                end
                break
            end
        end
    end
    for _, gui in ipairs(CoreGui:GetChildren()) do hideIfAd(gui) end
    for _, gui in ipairs(lp.PlayerGui:GetChildren()) do hideIfAd(gui) end
    adBlockConn = lp.PlayerGui.ChildAdded:Connect(function(c) task.wait(0.1); hideIfAd(c) end)
end
local function unblockAds()
    if adBlockConn then adBlockConn:Disconnect(); adBlockConn = nil end
    for _, gui in ipairs(hiddenGuis) do pcall(function() gui.Enabled = true end) end
    hiddenGuis = {}
end

-- ============================================================
--  FULL BRIGHT / FRESHENER
-- ============================================================
local origAmbient, origBrightness, origFogEnd
local function enableFullBright()
    origAmbient    = Lighting.Ambient
    origBrightness = Lighting.Brightness
    origFogEnd     = Lighting.FogEnd
    Lighting.Ambient    = Color3.fromRGB(178,178,178)
    Lighting.Brightness = 2
    Lighting.FogEnd     = 100000
end
local function disableFullBright()
    if origAmbient    then Lighting.Ambient    = origAmbient    end
    if origBrightness then Lighting.Brightness = origBrightness end
    if origFogEnd     then Lighting.FogEnd     = origFogEnd     end
end

-- ============================================================
--  FLASHLIGHT
-- ============================================================
local flashlight = nil
local flashConn  = nil
local function enableFlashlight()
    local char = lp.Character; if not char then return end
    local hrp  = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    flashlight = Instance.new("SpotLight")
    flashlight.Brightness = 5
    flashlight.Range      = 60
    flashlight.Angle      = 70
    flashlight.Face       = Enum.NormalId.Front
    flashlight.Parent     = hrp
    flashConn = RunService.Heartbeat:Connect(function()
        local c = lp.Character
        local r = c and c:FindFirstChild("HumanoidRootPart")
        if r and flashlight then flashlight.Parent = r end
    end)
end
local function disableFlashlight()
    if flashConn then flashConn:Disconnect(); flashConn = nil end
    if flashlight then flashlight:Destroy(); flashlight = nil end
end

-- ============================================================
--  BUILD UI
-- ============================================================
makeHeader("  VISUALS", 1)
local g1 = makeGrid(2)
makeToggle(g1, "Full Bright", Color3.fromRGB(255,220,60), function(on)
    if on then enableFullBright() else disableFullBright() end
end)
makeToggle(g1, "Flashlight", Color3.fromRGB(200,200,60), function(on)
    if on then enableFlashlight() else disableFlashlight() end
end)

makeHeader("  UTILITY", 10)
local g2 = makeGrid(11)
makeToggle(g2, "Ad Blocker", Color3.fromRGB(60,200,120), function(on)
    if on then blockAds() else unblockAds() end
end)
makeToggle(g2, "No Fog", Color3.fromRGB(100,180,255), function(on)
    Lighting.FogEnd = on and 100000 or 1000
end)

print("[Tab_Bax] Loaded.")
