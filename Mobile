-- ============================================================
--  HELPERS
-- ============================================================
local function makeCorner(p, r)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r or 8); c.Parent = p
end
local function makeStroke(p, col, th, trans)
    local s = Instance.new("UIStroke")
    s.Color = col or Color3.fromRGB(60,60,90); s.Thickness = th or 1
    s.Transparency = trans or 0; s.Parent = p
end
local function makeHeader(txt, order)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1,-4,0,24); f.BackgroundTransparency = 1
    f.LayoutOrder = order; f.Parent = scrollFrame
    local accent = Instance.new("Frame")
    accent.Size = UDim2.new(0,3,0,14); accent.Position = UDim2.new(0,2,0.5,-7)
    accent.BackgroundColor3 = Color3.fromRGB(100,120,255); accent.BorderSizePixel = 0
    accent.Parent = f; makeCorner(accent,2)
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1,-14,1,0); l.Position = UDim2.new(0,12,0,0)
    l.BackgroundTransparency = 1; l.Text = txt
    l.TextColor3 = Color3.fromRGB(160,170,220); l.Font = Enum.Font.FredokaOne
    l.TextSize = 12; l.TextXAlignment = Enum.TextXAlignment.Left; l.Parent = f
end
local function makeGrid(order)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1,-4,0,0); f.AutomaticSize = Enum.AutomaticSize.Y
    f.BackgroundTransparency = 1; f.BorderSizePixel = 0
    f.LayoutOrder = order; f.Parent = scrollFrame
    local g = Instance.new("UIGridLayout")
    g.CellSize = UDim2.new(0.5,-4,0,52); g.CellPadding = UDim2.new(0,4,0,4)
    g.SortOrder = Enum.SortOrder.LayoutOrder; g.Parent = f
    return f
end
local function makeToggle(parent, label, color, onToggle)
    local row = Instance.new("Frame")
    row.BackgroundColor3 = Color3.fromRGB(18,20,34); row.BorderSizePixel = 0
    row.Size = UDim2.new(1,0,1,0); row.Parent = parent
    makeCorner(row,8); makeStroke(row, Color3.fromRGB(45,45,70),1,0)
    local pill = Instance.new("Frame")
    pill.Size = UDim2.new(0,4,0,18); pill.Position = UDim2.new(0,6,0.5,-9)
    pill.BackgroundColor3 = color; pill.BorderSizePixel = 0; pill.Parent = row; makeCorner(pill,3)
    local swBg = Instance.new("TextButton")
    swBg.Size = UDim2.new(0,36,0,18); swBg.Position = UDim2.new(1,-42,0.5,-9)
    swBg.BackgroundColor3 = Color3.fromRGB(40,40,65); swBg.BorderSizePixel = 0
    swBg.Text = ""; swBg.AutoButtonColor = false; swBg.Parent = row
    makeCorner(swBg,9); makeStroke(swBg, Color3.fromRGB(60,60,90),1,0)
    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0,12,0,12); knob.Position = UDim2.new(0,3,0.5,-6)
    knob.BackgroundColor3 = Color3.fromRGB(140,140,170); knob.BorderSizePixel = 0
    knob.Parent = swBg; makeCorner(knob,6)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1,-58,1,0); lbl.Position = UDim2.new(0,16,0,0)
    lbl.BackgroundTransparency = 1; lbl.Text = label
    lbl.TextColor3 = Color3.fromRGB(210,215,235); lbl.Font = Enum.Font.FredokaOne
    lbl.TextSize = 12; lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextWrapped = true; lbl.Parent = row
    local enabled = false
    local ti = TweenInfo.new(0.15,Enum.EasingStyle.Quad,Enum.EasingDirection.Out)
    local function refresh()
        if enabled then
            TweenService:Create(swBg,ti,{BackgroundColor3=Color3.fromRGB(60,160,255)}):Play()
            TweenService:Create(knob,ti,{Position=UDim2.new(0,21,0.5,-6),BackgroundColor3=Color3.fromRGB(255,255,255)}):Play()
            TweenService:Create(row,ti,{BackgroundColor3=Color3.fromRGB(16,26,48)}):Play()
        else
            TweenService:Create(swBg,ti,{BackgroundColor3=Color3.fromRGB(40,40,65)}):Play()
            TweenService:Create(knob,ti,{Position=UDim2.new(0,3,0.5,-6),BackgroundColor3=Color3.fromRGB(140,140,170)}):Play()
            TweenService:Create(row,ti,{BackgroundColor3=Color3.fromRGB(18,20,34)}):Play()
        end
    end
    swBg.MouseButton1Click:Connect(function()
        enabled = not enabled; refresh(); onToggle(enabled)
    end)
    refresh()
end
local function makeBtn(txt, color, order, fn)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1,-4,0,36); b.BackgroundColor3 = color
    b.TextColor3 = Color3.fromRGB(255,255,255); b.Font = Enum.Font.FredokaOne
    b.TextSize = 12; b.Text = txt; b.BorderSizePixel = 0
    b.AutoButtonColor = false; b.LayoutOrder = order; b.Parent = scrollFrame
    makeCorner(b,8); makeStroke(b,Color3.fromRGB(80,80,120),1,0.4)
    b.MouseButton1Click:Connect(function() pcall(fn) end)
end

-- ============================================================
--  SHIFTLOCK
-- ============================================================
local shiftLockConn = nil
local function enableShiftLock()
    local cam = workspace.CurrentCamera
    if not cam then return end
    cam.CameraType = Enum.CameraType.Custom
    local StarterGui = game:GetService("StarterGui")
    pcall(function()
        StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true)
    end)
    shiftLockConn = RunService.RenderStepped:Connect(function()
        local char = lp.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end
        if hum.MoveDirection.Magnitude > 0 then
            hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z))
        end
    end)
end
local function disableShiftLock()
    if shiftLockConn then shiftLockConn:Disconnect(); shiftLockConn = nil end
end

-- ============================================================
--  FLIPS
-- ============================================================
local function doFlip(front)
    local char = lp.Character; if not char then return end
    local hrp  = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local hum  = char:FindFirstChildOfClass("Humanoid"); if not hum then return end
    if hum.FloorMaterial == Enum.Material.Air then return end
    local dir = front and 1 or -1
    local vel = Instance.new("BodyVelocity")
    vel.Velocity = hrp.CFrame.LookVector * 20 * dir + Vector3.new(0, 30, 0)
    vel.MaxForce = Vector3.new(1e5, 1e5, 1e5); vel.Parent = hrp
    local ang = Instance.new("BodyAngularVelocity")
    ang.AngularVelocity = hrp.CFrame.RightVector * (front and -8 or 8)
    ang.MaxTorque = Vector3.new(1e5,1e5,1e5); ang.Parent = hrp
    task.delay(0.4, function() pcall(function() vel:Destroy(); ang:Destroy() end) end)
end

-- ============================================================
--  AIRJUMP
-- ============================================================
local airJumpEnabled = false
local jumped = false
UserInputSvc.JumpRequest:Connect(function()
    if not airJumpEnabled then return end
    local char = lp.Character; if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid"); if not hum then return end
    local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    if hum.FloorMaterial == Enum.Material.Air then
        if not jumped then
            jumped = true
            local bv = Instance.new("BodyVelocity")
            bv.Velocity = Vector3.new(hrp.Velocity.X, 50, hrp.Velocity.Z)
            bv.MaxForce = Vector3.new(0,1e5,0); bv.Parent = hrp
            task.delay(0.1, function() pcall(function() bv:Destroy() end) end)
        end
    else
        jumped = false
    end
end)

-- ============================================================
--  TPWALK
-- ============================================================
local tpWalkEnabled = false
local tpWalkConn    = nil
local tpSpeed       = 50

local function enableTpWalk()
    tpWalkConn = RunService.Heartbeat:Connect(function()
        local char = lp.Character; if not char then return end
        local hrp  = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
        local hum  = char:FindFirstChildOfClass("Humanoid"); if not hum then return end
        if hum.MoveDirection.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame + hum.MoveDirection * tpSpeed * 0.016
        end
    end)
end
local function disableTpWalk()
    if tpWalkConn then tpWalkConn:Disconnect(); tpWalkConn = nil end
end

