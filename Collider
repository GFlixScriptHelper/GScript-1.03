local function makeCorner(p, r)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r or 8); c.Parent = p
end
local function makeStroke(p, col, th, trans)
    local s = Instance.new("UIStroke")
    s.Color = col or Color3.fromRGB(60,60,90); s.Thickness = th or 1
    s.Transparency = trans or 0; s.Parent = p
end
local function makeHeader(txt, order)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1,-4,0,24); f.BackgroundTransparency = 1
    f.LayoutOrder = order; f.Parent = scrollFrame
    local accent = Instance.new("Frame")
    accent.Size = UDim2.new(0,3,0,14); accent.Position = UDim2.new(0,2,0.5,-7)
    accent.BackgroundColor3 = Color3.fromRGB(100,120,255); accent.BorderSizePixel = 0
    accent.Parent = f; makeCorner(accent,2)
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1,-14,1,0); l.Position = UDim2.new(0,12,0,0)
    l.BackgroundTransparency = 1; l.Text = txt
    l.TextColor3 = Color3.fromRGB(160,170,220); l.Font = Enum.Font.FredokaOne
    l.TextSize = 12; l.TextXAlignment = Enum.TextXAlignment.Left; l.Parent = f
end
local function makeGrid(order)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1,-4,0,0); f.AutomaticSize = Enum.AutomaticSize.Y
    f.BackgroundTransparency = 1; f.BorderSizePixel = 0
    f.LayoutOrder = order; f.Parent = scrollFrame
    local g = Instance.new("UIGridLayout")
    g.CellSize = UDim2.new(0.5,-4,0,52); g.CellPadding = UDim2.new(0,4,0,4)
    g.SortOrder = Enum.SortOrder.LayoutOrder; g.Parent = f
    return f
end
local function makeToggle(parent, label, color, onToggle)
    local row = Instance.new("Frame")
    row.BackgroundColor3 = Color3.fromRGB(18,20,34); row.BorderSizePixel = 0
    row.Size = UDim2.new(1,0,1,0); row.Parent = parent
    makeCorner(row,8); makeStroke(row, Color3.fromRGB(45,45,70),1,0)
    local pill = Instance.new("Frame")
    pill.Size = UDim2.new(0,4,0,18); pill.Position = UDim2.new(0,6,0.5,-9)
    pill.BackgroundColor3 = color; pill.BorderSizePixel = 0; pill.Parent = row; makeCorner(pill,3)
    local swBg = Instance.new("TextButton")
    swBg.Size = UDim2.new(0,36,0,18); swBg.Position = UDim2.new(1,-42,0.5,-9)
    swBg.BackgroundColor3 = Color3.fromRGB(40,40,65); swBg.BorderSizePixel = 0
    swBg.Text = ""; swBg.AutoButtonColor = false; swBg.Parent = row
    makeCorner(swBg,9); makeStroke(swBg, Color3.fromRGB(60,60,90),1,0)
    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0,12,0,12); knob.Position = UDim2.new(0,3,0.5,-6)
    knob.BackgroundColor3 = Color3.fromRGB(140,140,170); knob.BorderSizePixel = 0
    knob.Parent = swBg; makeCorner(knob,6)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1,-58,1,0); lbl.Position = UDim2.new(0,16,0,0)
    lbl.BackgroundTransparency = 1; lbl.Text = label
    lbl.TextColor3 = Color3.fromRGB(210,215,235); lbl.Font = Enum.Font.FredokaOne
    lbl.TextSize = 12; lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextWrapped = true; lbl.Parent = row
    local enabled = false
    local ti = TweenInfo.new(0.15,Enum.EasingStyle.Quad,Enum.EasingDirection.Out)
    local function refresh()
        if enabled then
            TweenService:Create(swBg,ti,{BackgroundColor3=Color3.fromRGB(60,160,255)}):Play()
            TweenService:Create(knob,ti,{Position=UDim2.new(0,21,0.5,-6),BackgroundColor3=Color3.fromRGB(255,255,255)}):Play()
            TweenService:Create(row,ti,{BackgroundColor3=Color3.fromRGB(16,26,48)}):Play()
        else
            TweenService:Create(swBg,ti,{BackgroundColor3=Color3.fromRGB(40,40,65)}):Play()
            TweenService:Create(knob,ti,{Position=UDim2.new(0,3,0.5,-6),BackgroundColor3=Color3.fromRGB(140,140,170)}):Play()
            TweenService:Create(row,ti,{BackgroundColor3=Color3.fromRGB(18,20,34)}):Play()
        end
    end
    swBg.MouseButton1Click:Connect(function()
        enabled = not enabled; refresh(); onToggle(enabled)
    end)
    refresh()
end

-- ============================================================
--  COLLIDER LOGIC
-- ============================================================
local colliderHighlights = {}
local noClipConn         = nil

local COLLIDER_KEYWORDS = {
    "NoClip_Collider", "Collider", "InvisibleWall",
    "Barrier", "Blocker", "Boundary"
}

local function findColliders()
    local found = {}
    local function search(parent)
        for _, obj in ipairs(parent:GetChildren()) do
            if obj:IsA("BasePart") then
                for _, kw in ipairs(COLLIDER_KEYWORDS) do
                    if obj.Name:lower():find(kw:lower()) then
                        table.insert(found, obj); break
                    end
                end
            end
            if #obj:GetChildren() > 0 then search(obj) end
        end
    end
    search(workspace)
    return found
end

local function showColliders()
    for _, hl in ipairs(colliderHighlights) do pcall(function() hl:Destroy() end) end
    colliderHighlights = {}
    for _, obj in ipairs(findColliders()) do
        local hl = Instance.new("Highlight")
        hl.FillColor = Color3.fromRGB(255, 80, 80)
        hl.OutlineColor = Color3.fromRGB(255, 200, 80)
        hl.FillTransparency = 0.4
        hl.OutlineTransparency = 0
        hl.Adornee = obj
        hl.Parent  = workspace
        table.insert(colliderHighlights, hl)
    end
end
local function hideColliders()
    for _, hl in ipairs(colliderHighlights) do pcall(function() hl:Destroy() end) end
    colliderHighlights = {}
end
local function enableNoClip()
    noClipConn = RunService.Stepped:Connect(function()
        local char = game:GetService("Players").LocalPlayer.Character
        if not char then return end
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end)
end
local function disableNoClip()
    if noClipConn then noClipConn:Disconnect(); noClipConn = nil end
end

